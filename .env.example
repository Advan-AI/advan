# ──────────────────────────────────────────────
# Phase 1 — Auth + DB
# ──────────────────────────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/advan_ai
DB_APP_NAME=advan
# Optional pool tuning (defaults: Next.js max=3, workers max=2 via DB_POOL_ROLE=worker)
# DB_MAX_CONNECTIONS=3
# WORKER_DB_MAX_CONNECTIONS=2
# DB_SSL=require   # auto-enabled for *.supabase.com; set false for local TLS-off

NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL=http://localhost:3000

# Demo auto-login (default on). Uses seed tenant admin@acme.co / password123.
# DEMO_AUTO_LOGIN=true
# DEMO_LOGIN_EMAIL=admin@acme.co

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ──────────────────────────────────────────────
# Phase 2 — Infrastructure Services
# ──────────────────────────────────────────────
ALIBABA_FC_URL=https://advan-rendpoint-aesaiqgtla.ap-southeast-1.fcapp.run
NEXT_PUBLIC_ALIBABA_FC_URL=https://advan-rendpoint-aesaiqgtla.ap-southeast-1.fcapp.run

# Temporal — defaults: local frontend on 7233, namespace "default"
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Optional mTLS: both TEMPORAL_CERT and TEMPORAL_KEY (base64 PEM) required when used
# TEMPORAL_CERT=
# TEMPORAL_KEY=
# TEMPORAL_WORKFLOW_BUNDLE_PATH=lib/temporal/dist/workflow-bundle.js
TEMPORAL_TASK_QUEUE=advan-agents

# BullMQ — Redis wire protocol (TCP). Local: point at Docker/homebrew Redis. Production: TLS URL ok
# (e.g. rediss://default:<token>@<host>.upstash.io:6379).
REDIS_URL=redis://localhost:6379

# Optional — Upstash REST credentials for tRPC rate limiting only. BullMQ does not use these.
# Leave unset in local dev to skip rate limits. Set both when you want @upstash/ratelimit in prod.
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Dev-only escape hatch for Resend inbound sender mismatch testing. Never enable in production.
ALLOW_UNVERIFIED_SENDER_DEV=false

AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=advan-kb-documents

# ──────────────────────────────────────────────
# Phase 4 — AI Core
# ──────────────────────────────────────────────
# Chat: Ollama (local) or Anthropic — see lib/llm/config.ts
LLM_CHAT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TRIAGE_MODEL=llama3.2
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Confidence threshold below which answers route to HITL (0–1 scale)
HALLUCINATION_THRESHOLD=0.72
TRIAGE_AUTO_SEND_THRESHOLD=85

# Open Policy Agent — leave blank to use inline Rego simulation
OPA_SERVICE_URL=http://localhost:8181


# ──────────────────────────────────────────────
# Phase 5 — Realtime
# ──────────────────────────────────────────────
# Socket.IO HITL server port (standalone process: npx tsx lib/realtime/socket-server.ts)
SOCKET_PORT=3002
# Browser Socket.IO URL (defaults to same host on port 3002)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002

# ──────────────────────────────────────────────
# Phase 6 — Observability + Hardening
# ──────────────────────────────────────────────
# Sentry — SDK only sends when NODE_ENV=production. Set in prod env, optional locally.
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
# SENTRY_AUTH_TOKEN=your-sentry-auth-token
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=advan-ai
GITGUARDIAN_API_KEY=your-gitguardian-api-key

# LangSmith — enabled whenever LANGSMITH_API_KEY is set
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=advan-ai

# OpenTelemetry OTLP — initialised only when NODE_ENV=production
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otlp-endpoint/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic your-base64-credentials
# OTEL_SERVICE_NAME=advan-ai

# ──────────────────────────────────────────────
# MCP Server
# ──────────────────────────────────────────────
# Org UUID to scope all MCP tool calls to a single tenant
MCP_ORG_ID=your-org-uuid-here

# Port for the HTTP+SSE MCP transport (npx tsx lib/mcp/http-server.ts)
MCP_PORT=3001
MCP_ALLOWED_ORIGIN=http://localhost:3000

# Cursor ~/.cursor/mcp.json registration (stdio transport):
# {
#   "mcpServers": {
#     "advan": {
#       "command": "npx",
#       "args": ["tsx", "/path/to/v0-advan/lib/mcp/server.ts"],
#       "env": { "DATABASE_URL": "...", "MCP_ORG_ID": "..." }
#     }
#   }
# }

# ──────────────────────────────────────────────
# Alibaba Cloud Model Studio, Tablestore & OSS
# ──────────────────────────────────────────────
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_CHAT_BASE_URL=https://ws-v4i00dfu6lxnw0w5.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_ENDPOINT=https://ws-v4i00dfu6lxnw0w5.ap-southeast-1.maas.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
DASHSCOPE_GLOBAL_EMBEDDING_ENDPOINT=https://ws-v4i00dfu6lxnw0w5.ap-southeast-1.maas.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

TABLESTORE_INSTANCE_NAME=your-tablestore-instance-name
TABLESTORE_ENDPOINT=https://your-instance.ap-southeast-1.ots.aliyuncs.com
TABLESTORE_ACCESS_KEY_ID=your-aliyun-access-key-id
TABLESTORE_ACCESS_KEY_SECRET=your-aliyun-access-key-secret

ALIBABA_OSS_BUCKET=advan-kb-documents
ALIBABA_OSS_REGION=oss-ap-southeast-1

# ──────────────────────────────────────────────
# FC Sandbox / E2B — lib/sandbox/fc-sandbox-client.ts
# ──────────────────────────────────────────────
# Leave unset to run the sandbox client in simulated mode (default, no
# credentials needed). Set both to switch to Alibaba's real E2B-compatible
# FC Sandbox API. Template must be registered first — see
# fc-sandbox/build_template.py and fc-sandbox/.env.example.
# E2B_API_URL=https://api.us-west-1.e2b.fc.aliyuncs.com
# E2B_API_KEY=your-fc-sandbox-e2b-api-key
# E2B_DOMAIN=us-west-1.e2b.fc.aliyuncs.com
# E2B_TEMPLATE_ID=template-id-from-build_template.py

