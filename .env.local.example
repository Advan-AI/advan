# Copy to `.env.local` and replace placeholders with your real values.
# `.env.local` is gitignored — this file should stay safe to commit (no real secrets).

NODE_ENV=development
# ──────────────────────────────────────────────
# Phase 1 — Auth + DB
# ──────────────────────────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/advan_ai

NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# Use http://127.0.0.1:3000 if you see NextAuth "[auth] fetch failed" with localhost (IPv6 vs IPv4).
NEXTAUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
#
# Google Cloud Console → APIs & Services → Credentials → your OAuth client:
#   Authorized JavaScript origins:   {NEXTAUTH_URL}     e.g. http://localhost:3000
#   Authorized redirect URIs:        {NEXTAUTH_URL}/api/auth/callback/google
# Use the SAME host you type in the browser (localhost vs 127.0.0.1) as in NEXTAUTH_URL.
# No trailing slash on NEXTAUTH_URL (this app normalizes it, but keep Console URIs exact).

# ──────────────────────────────────────────────
# Phase 2 — Infrastructure Services
# ──────────────────────────────────────────────
# KB vectors: Postgres pgvector + Ollama embeddings (see Phase 4 OLLAMA_*). No Pinecone/OpenAI embeddings.

# Temporal — defaults target local dev server (docker-compose temporal-ui / temporalite)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Optional mTLS (Temporal Cloud / secured clusters): set BOTH, base64-encoded PEM
# TEMPORAL_CERT=
# TEMPORAL_KEY=
# Production worker: path to file emitted by `npm run temporal:bundle`
# TEMPORAL_WORKFLOW_BUNDLE_PATH=lib/temporal/dist/workflow-bundle.js
# TEMPORAL_TASK_QUEUE=advan-agents

# BullMQ — Redis wire protocol (TCP). Local dev: local Redis. Production: any compatible URL
# (e.g. Upstash TLS: rediss://default:<token>@<host>.upstash.io:6379, ElastiCache, Redis Cloud, …).
REDIS_URL=redis://localhost:6379

# Optional — Upstash REST for tRPC rate limiting only.
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=advan-kb-documents

# ──────────────────────────────────────────────
# Phase 4 — AI Core
# ──────────────────────────────────────────────
# Chat stack (pick one primary via LLM_CHAT_PROVIDER or implicit defaults — see lib/llm/config.ts)
# - ollama: local Ollama OpenAI-compatible API (OLLAMA_*). Default when Anthropic key absent.
# - anthropic: Claude Haiku/Sonnet (ANTHROPIC_API_KEY).
LLM_CHAT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TRIAGE_MODEL=llama3.2
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
# Fallback chat completions when primary fails (OpenAI-compatible Groq API)
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Legacy Claude — set LLM_CHAT_PROVIDER=anthropic to use
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Confidence threshold below which answers route to HITL (0–1 scale)
HALLUCINATION_THRESHOLD=0.72

# Open Policy Agent — leave blank to use inline Rego simulation
OPA_SERVICE_URL=http://localhost:8181

# Microsoft Presidio sidecar — leave blank to use regex patterns
# docker run -p 5002:5002 mcr.microsoft.com/presidio-analyzer
PRESIDIO_SERVICE_URL=http://localhost:5002

# ──────────────────────────────────────────────
# Phase 5 — Realtime
# ──────────────────────────────────────────────
# Socket.IO HITL server port (standalone process: npx tsx lib/realtime/socket-server.ts)
SOCKET_PORT=3002
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002

# ──────────────────────────────────────────────
# Phase 6 — Observability + Hardening
# ──────────────────────────────────────────────
# Sentry — app only sends events when NODE_ENV=production (see sentry.*.config.ts).
# Set these in production env (e.g. Vercel), not required for local dev.
# NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
# SENTRY_AUTH_TOKEN=...   # CI/source maps upload, not runtime
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=advan-ai

# LangSmith — enabled whenever LANGSMITH_API_KEY is set (any NODE_ENV)
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=advan-ai

# OpenTelemetry OTLP — exporter initialised only when NODE_ENV=production (see instrumentation.ts).
# Optional locally; set on production hosts / containers.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otlp-endpoint/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic your-base64-credentials
# OTEL_SERVICE_NAME=advan-ai

# ──────────────────────────────────────────────
# MCP Server
# ──────────────────────────────────────────────
# Org UUID to scope all MCP tool calls to a single tenant
MCP_ORG_ID=your-org-uuid-here

# Port for the HTTP+SSE MCP transport (npx tsx lib/mcp/http-server.ts)
MCP_PORT=3001

# ──────────────────────────────────────────────
# Email (Resend) — two-way ticket/conversation mail
# ──────────────────────────────────────────────
# When RESEND_API_KEY is set, all four vars below are required (lib/email/config.ts).
# Resend API key (Dashboard → API Keys)
# RESEND_API_KEY=re_...
# Verified sending address on your Resend domain
# EMAIL_FROM=Acme Support <support@mail.yourdomain.com>
# Subdomain with MX for inbound (reply+{convId}@...)
# EMAIL_INBOUND_DOMAIN=mail.yourdomain.com
# From Resend webhook create response; used for Svix signature verify
# RESEND_WEBHOOK_SECRET=whsec_...

# Cursor ~/.cursor/mcp.json registration (stdio transport):
# {
#   "mcpServers": {
#     "advan": {
#       "command": "npx",
#       "args": ["tsx", "/path/to/v0-advan/lib/mcp/server.ts"],
#       "env": { "DATABASE_URL": "...", "MCP_ORG_ID": "..." }
#     }
#   }
# }
