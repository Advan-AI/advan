# Copy to fc-sandbox/.env and fill in real values. Loaded by
# build_template.py and start-gateway.py (Path(__file__).parent / ".env" —
# this directory, not the repo root). Never commit the real .env.

# ── E2B API Configuration ──────────────────────────────────────────────
# Your Alibaba Cloud FC Sandbox API key.
E2B_API_KEY=
# E2B-compatible API endpoint for your FC Sandbox region.
E2B_API_URL=https://api.us-west-1.e2b.fc.aliyuncs.com
# Domain associated with your FC Sandbox region.
E2B_DOMAIN=us-west-1.e2b.fc.aliyuncs.com
# Sandbox lifetime in seconds before auto-terminating if idle.
E2B_TIMEOUT=86400
# Action on timeout: "pause" (suspend, resumable) or "destroy".
E2B_ON_TIMEOUT=pause

# ── Template Build Configuration ───────────────────────────────────────
# Full path to the pushed container image (ACR or GHCR — either works via
# E2B_TEMPLATE_SOURCE_USERNAME/PASSWORD below for private registries).
# e.g. advan-registry.us-west-1.cr.aliyuncs.com/advan/advan:v1.0
# or   ghcr.io/<username>/<image_name>:<tag>
E2B_TEMPLATE_IMAGE=
E2B_TEMPLATE_SOURCE_USERNAME=
E2B_TEMPLATE_SOURCE_PASSWORD=
E2B_TEMPLATE_CPU=2
E2B_TEMPLATE_MEMORY_MB=2048
# Set after running: python build_template.py
E2B_TEMPLATE_ID=

# ── LLM Model Configuration ────────────────────────────────────────────
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_COMPATIBILITY=anthropic
MODEL_NAME=qwen3.7-plus

# ── OpenClaw Application Configuration ─────────────────────────────────
OPENCLAW_TOKEN=
